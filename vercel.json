{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/stranica?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/stranica?sto=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/stranica?sto=robots"
    },
    {
      "source": "/c/:token",
      "destination": "/c.html"
    },
    {
      "source": "/h/:token",
      "destination": "/h.html?token=:token"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/add-property",
      "destination": "/add-property.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/email-confirm",
      "destination": "/email-confirm.html"
    }
  ],
  "headers": [
    {
      "source": "/h/:slug",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/c/:token",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/stranica.js": {
      "includeFiles": "p.html"
    },
    "api/sync-all.js": {
      "maxDuration": 60
    },
    "api/keepalive.js": {
      "maxDuration": 60
    }
  }
}
